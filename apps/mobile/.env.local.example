# Point the app at the local Supabase stack instead of the cloud project.
#
# Copy this file to `.env.local` and fill in the values that `supabase start`
# prints (re-print them any time with `supabase status`). Expo loads `.env.local`
# at a higher priority than the committed `.env`, so the cloud values stay intact
# and `.env.local` is gitignored.
#
#   cp apps/mobile/.env.local.example apps/mobile/.env.local
#
# The API URL is stable across machines; the key is generated per stack, so copy
# the "anon key" (or "publishable key") from the CLI output rather than guessing.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-key-from-supabase-start
